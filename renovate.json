{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "@(system|platform|apps)/*/templates/**/*.yaml"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/(^|/)Chart\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate: image=(?<depName>.*?)\\s+appVersion:\\s*[\"']?(?<currentValue>[\\w+\\.\\-]*)"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "metal/vars.yaml"
      ],
      "matchStrings": [
        "#\\s*renovate: image=(?<depName>.*?)\\s+[\\w_\\-]+:\\s*[\"']?(?<currentValue>[\\w+\\.\\-]*)"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "git-refs",
      "managerFilePatterns": [
        "/(^|/)kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate: gh-ref\\s+[^\\n]*?https://raw\\.githubusercontent\\.com/(?<depName>\\S+/\\S+)/(?<currentDigest>[0-9a-fA-F]+)/"
      ],
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchPackageNames": [
        "longhorn"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "registry.k8s.io/*",
        "ghcr.io/siderolabs/kubelet"
      ],
      "matchDatasources": [
        "docker"
      ],
      "groupName": "kubernetes-controlplane",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "renovate/renovate"
      ],
      "schedule": [
        "* 4-6 * * *"
      ],
      "automergeType": "branch"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "ignoreTests": true,
  "prConcurrentLimit": 0
}